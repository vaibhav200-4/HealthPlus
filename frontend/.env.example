# Frontend Environment Variables Template for Vercel Deployment

# Production FastAPI Backend URL
VITE_API_URL=https://healthplus-backend-nwpw.onrender.com
VITE_API_BASE_URL=https://healthplus-backend-nwpw.onrender.com/api

# Supabase Credentials (Public Client Keys Only - Safe for browser)
