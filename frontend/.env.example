# Frontend Environment Variables Template for Vercel Deployment

# Production FastAPI Backend URL (e.g. https://koala-pentagram-florist.ngrok-free.dev/api or https://api.yourdomain.com/api)
VITE_API_BASE_URL=https://your-backend-api-domain.com/api

# Supabase Credentials (Public Client Keys Only - Safe for browser)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
