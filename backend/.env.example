# Backend Environment Variables Template (Redacted / Blanked)

ENVIRONMENT=development
PORT=8000
ALLOW_DEMO_SEED=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://user:password@host:port/database

# Security & Secrets
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
N8N_JWT_SECRET=your-n8n-jwt-secret
VOICE_SERVICE_SECRET=your-voice-service-secret
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
ENABLE_TELEGRAM_HMAC_VERIFICATION=false

# LLM Providers & AI Keys
LLM_PROVIDER=nvidia
GOOGLE_API_KEY=your-google-api-key
NVIDIA_API_KEY=your-nvidia-api-key
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
CARTESIA_API_KEY=your-cartesia-api-key

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=hospital-doctors
USE_PINECONE_RAG=false

# External Integrations
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
NGROCK_API_KEY=your-ngrok-api-key

# App Identities
ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
AGENT_USER_ID=0042bb23-509d-42e7-b05c-2a519f354c4b
